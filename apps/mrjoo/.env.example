# ---- مطلوب ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=anon-public-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key   # سرّي: سيرفر فقط
ADMIN_KEY=choose-a-long-random-string        # لصفحة /admin
CRON_SECRET=another-long-random-string       # للإغلاق الأسبوعي التلقائي
MARKET_SEED=any-secret-number                # يخلي أسعار محاكاة التداول غير قابلة للتوقع

# ---- فودافون كاش (رقمك لاستلام الشحن) ----
VODAFONE_CASH_NUMBER=010XXXXXXXX

# ---- اختياري ----
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_FEED_SLOT=1234567890
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
COIN_PRICE_EGP=0.1       # سعر العملة عند الشحن
CREATOR_SHARE=0.5        # نصيب صانع المحتوى من هدايا العملات المدفوعة
MIN_WITHDRAW_EGP=50

# ---- فيديو ضخم (اختياري — بدونه يُستخدم تخزين Supabase حتى ٥٠ ميجا) ----
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=
CF_STREAM_DOMAIN=customer-xxxx.cloudflarestream.com

# ---- MRJOO PRO merged guide ----
ADMIN_ID=your-unique-admin-id
# Optional Stripe/Connect (not required for the existing Vodafone Cash wallet flow)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CONNECTED_ACCOUNT_ID=acct_...

# ضعها في Vercel لمشروع المنصة (apps/platform). انظر docs/ENV.md
# عامة (آمنة للواجهة)
NEXT_PUBLIC_SUPABASE_URL=
# المفتاح العام الجديد الموصى به؛ يمكن إبقاء ANON_KEY الحالي مؤقتًا للتوافق
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# سرية: للسيرفر فقط. لا تضعها في Git ولا في أي ملف عام
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
